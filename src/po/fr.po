msgid "A widget factory - GTK %d.%d"
msgstr "La fabrique à widgets - GTK %d.%d"

#: gtk-awf/src/awf-gtk2.c:599 gtk-awf/src/awf-gtk2.c:1320
#: gtk-awf/src/awf-gtk2.c:2230 gtk-awf/src/awf-gtk2.c:2258
#: gtk-awf/src/awf-gtk3.c:678 gtk-awf/src/awf-gtk3.c:1631
#: gtk-awf/src/awf-gtk3.c:2606 gtk-awf/src/awf-gtk3.c:2648
