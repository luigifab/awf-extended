pkgname=awf-qt6
pkgver=4.2.0
pkgrel=1
pkgdesc="Theme preview application for Qt 6"
url="https://github.com/luigifab/awf-extended"
license="GPL-3.0-or-later"
arch="all"
depends="qt6-qtbase libnotify hicolor-icon-theme"
makedepends="autoconf automake desktop-file-utils hicolor-icon-theme gcc gettext qt6-qtbase-dev libnotify-dev"
subpackages="$pkgname-doc"
source="awf-extended-$pkgver.tar.gz::https://github.com/luigifab/awf-extended/archive/v${pkgver}/awf-extended-${pkgver}.tar.gz"
builddir="$srcdir/awf-extended-$pkgver"

build() {
	autoreconf -fi
	./configure \
		--host=$CHOST \
		--build=$CBUILD \
		--prefix=/usr \
		--mandir=/usr/share/man \
		--enable-only-qt6
	make -s
}

package() {
	make install DESTDIR="$pkgdir"
	install -Dm644 README.md "$pkgdir"/usr/share/doc/$pkgname/README.md
	#install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}