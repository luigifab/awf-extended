pkgname=awf-qt4
pkgver=4.3.0
pkgrel=1
pkgdesc='Theme preview application for Qt 4'
url='https://github.com/luigifab/awf-extended'
license=('GPL3')
arch=('x86_64')
depends=('qt4>=4.8.0' 'desktop-file-utils' 'hicolor-icon-theme')
#optdepends=('qt4-style-globalqss: for theme support')
#makedepends=('autoconf' 'automake' 'desktop-file-utils' 'gcc' 'gettext' 'qt4')
source=("https://github.com/luigifab/awf-extended/archive/v${pkgver}/awf-extended-${pkgver}.tar.gz")
sha256sums=('SKIP')

prepare() {
  mv "awf-extended-$pkgver" "$pkgname-$pkgver"
}

build() {
  cd "$pkgname-$pkgver"
  autoreconf -fi
  ./configure --prefix=/usr --enable-only-qt4
  make -s
}

package() {
  cd "$pkgname-$pkgver"
  make install DESTDIR="$pkgdir"
  install -Dpm 644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  #install -Dpm 644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}